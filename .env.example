# Flare Coston2 Testnet
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114

# Deployer wallet (NEVER commit your real key)
DEPLOYER_PRIVATE_KEY=0x_your_testnet_private_key_here

# Flare Confidential Compute endpoint (provided by Flare dev docs)
FLARE_CONFIDENTIAL_ENDPOINT=https://coston2-confidential.flare.network

# FAsset Manager address on Coston2 (check https://dev.flare.network for latest)
FASSET_MANAGER_ADDRESS=0x_

