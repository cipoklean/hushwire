# ── Flare Coston2 Testnet ──
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
FLARE_CHAIN_ID=114

# Deployer wallet (NEVER commit your real key).
# Also acts as the attestation authority (SignatureVerifier) and funds demo agents.
DEPLOYER_PRIVATE_KEY=0x_your_testnet_private_key_here

# ── MCP server agent key ──
# The MCP server acts as ONE agent; it reads AGENT_PRIVATE_KEY, falling back to
# DEPLOYER_PRIVATE_KEY. Use a dedicated key for the MCP agent.
# AGENT_PRIVATE_KEY=0x_agent_key_here

# ── Example agents (examples/two-agents.ts) ──
# Optional; deterministic testnet keys are used if unset.
# AGENT_A_PRIVATE_KEY=0x...
# AGENT_B_PRIVATE_KEY=0x...
# AGENT_C_PRIVATE_KEY=0x...

# ── Commit-salt encryption (crash-safe store) ──
# Optional 32-byte key (hex) for AES-256-GCM at rest for .hushwire-salts-*.json.
# Without it the salts file is plaintext (demo only).
# HUSHWIRE_SALT_KEY=0x...

# ── Deployed contracts ──
# Populated automatically by `npm run deploy:coston2` into src/lib/addresses.json.
# Includes: fxrpToken, signatureVerifier, sealedBidAuction, hushWireVault, deployedBlock.

# ── Mainnet notes (do not use on testnet) ──
# On mainnet, rotate HushWireVault.setVerifier() from SignatureVerifier to
# Flare Confidential Compute's real on-chain attestation verifier, and replace
# MockFAsset with the real FAsset ERC20 minted by the FAssetManager system.

# ── Vercel (auto-set on deploy, listed for reference) ──
# NEXT_PUBLIC_FLARE_RPC_URL=
