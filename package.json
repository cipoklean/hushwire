{
  "name": "hushwire",
  "version": "0.1.0",
  "private": true,
  "description": "HushWire — Private agent-to-agent negotiation + FAssets settlement on Flare",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
